# Backend REST API base URL (local dev). In Vercel set this to your Render URL, e.g. https://<your-service>.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api
# true  = everything runs on demo (mock) data
# false = EVERY module uses the real backend (only when all backend modules exist)
VITE_USE_MOCK=true
# Connect only specific modules to the real backend; all others stay in demo mode.
# Available: auth, accounts, transactions, dashboard
VITE_REAL_MODULES=auth,accounts,transactions,dashboard
# Optional: show the demo login hint on the login page even when auth is live
VITE_SHOW_DEMO_HINT=true
