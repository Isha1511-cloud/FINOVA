# Copy to .env (same folder as app.js) and fill in. NEVER commit .env.
PORT=5000

# MongoDB Atlas: Database > Connect > Drivers.
# Format: mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F, # -> %23).
MONGODB_URI=
MONGODB_DB_NAME=finova

# REQUIRED for login/registration. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Allowed browser origin(s) for CORS, comma-separated (add your Vercel URL in production).
FRONTEND_URL=http://localhost:5173

# Optional tuning
DB_CONNECT_RETRIES=3
DB_RETRY_DELAY_MS=2000
DB_SERVER_SELECTION_TIMEOUT_MS=10000

# Development seed only (scripts/seed.js). Not used by the running API.
# SEED_DEMO_PASSWORD=
# Seeding is blocked when NODE_ENV=production unless ALLOW_SEED=true.

# AI assistant (Gemini free tier: the server sends ONLY redacted text, never customer data)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
