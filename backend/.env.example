# Copy to .env (same folder as app.js) and fill in. NEVER commit .env.
# Server port
PORT=5000

# [CONNECTION_STRING] - MongoDB Atlas: Database > Connect > Drivers.
# Format: mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Special characters in the password must be URL-encoded (@ -> %40, : -> %3A, / -> %2F, # -> %23).
MONGODB_URI=mongodb+srv://finova_15:finova15@finova.3r6kvq6.mongodb.net/finova?retryWrites=true&w=majority

# Optional: database name, used only if the URI has no /<database> path.
MONGODB_DB_NAME=finova

# Allowed browser origin(s) for CORS, comma-separated. Vite dev default shown.
FRONTEND_URL=http://localhost:5173

# Optional tuning
DB_CONNECT_RETRIES=3
DB_RETRY_DELAY_MS=2000
DB_SERVER_SELECTION_TIMEOUT_MS=10000

# AI assistant (Gemini free tier: the server sends ONLY redacted text, never customer data)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
